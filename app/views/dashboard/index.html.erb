<main>
  <div
   class="container-fluid px-4">
    <h1 class="mt-4">Panel del productor</h1>
    <div class="row">
      <div class="col-xl-4 col-md-12">
        <div class="card text-center mb-4">
          <div class="card-header bg-main">Machos <i class="fa-solid fa-mars"></i></div>
          <div class="card-body"><%= @total_male %></div>
        </div>
      </div>
      <div class="col-xl-4 col-md-12">
        <div class="card text-center mb-4">
          <div class="card-header bg-main">Hembras <i class="fa-solid fa-venus"></i></div>
          <div class="card-body"><%= @total_female %></div>
        </div>
      </div>
      <div class="col-xl-4 col-md-12">
        <div class="card text-center mb-4">
          <div class="card-header bg-main">Total <i class="fa-solid fa-venus-mars"></i></div>
          <div class="card-body"><%= @total %></div>
        </div>
      </div>
    </div>
    <div class="row">
      <div class="col-xl-4">
        <div class="card mb-4 text-center">
          <div class="card-header bg-main">
            Vivos (vigentes)
          </div>
          <div class="card-body"><%= @total %></div>
        </div>
      </div>
      <div class="col-xl-4">
        <div class="card mb-4 text-center">
          <div class="card-header bg-main">
            Vendidos
          </div>
          <div class="card-body"><%= @total_saled %></div>
        </div>
      </div>
      <div class="col-xl-4">
        <div class="card mb-4 text-center">
          <div class="card-header bg-main">
            Muertos
          </div>
          <div class="card-body"><%= @total_died %></div>
        </div>
      </div>
    </div>
    <div class="row">
      <div class="col-xl-6">
        <div class="card mb-4">
          <div class="card-header bg-main">
            Gráfico de Género
          </div>
          <div class="card-body">
            <%= column_chart  [
              { name: "Machos", data: { "Machos" => @total_male } },
              { name: "Hembras", data: { "Hembras" => @total_female } }
            ], loading: "Cargando..." %>
          </div>
        </div>
      </div>
      <div class="col-xl-6">
        <div class="card mb-4">
          <div class="card-header bg-main">
            Gráfico de Estado
          </div>
          <div class="card-body">
            <%= pie_chart [
              ["Vendidos", @total_saled],
              ["Muertos", @total_died],
              ["Vivos", @total]
            ], loading: "Cargando..." %>
          </div>
        </div>
      </div>
    </div>
  </div>
</main>
