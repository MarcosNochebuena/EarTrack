<%- if controller_name != 'sessions' %>
  <div class="text-center">
    <%= link_to t('common.login'), new_session_path(resource_name), class: "small" %><br />
  </div>
<% end %>

<%- if devise_mapping.registerable? && controller_name != 'registrations' %>
  <div class="text-center">
    <%= link_to t('common.sign_up'), new_registration_path(resource_name), class: "small" %><br />
  </div>
<% end %>

<%- if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' %>
  <div class="text-center">
    <%= link_to t('common.forgot_password'), new_password_path(resource_name), class: "small" %><br />
  </div>
<% end %>

<%- if devise_mapping.confirmable? && controller_name != 'confirmations' %>
  <div class="text-center">
    <%= link_to t('common.didnt_receive_confirmation'), new_confirmation_path(resource_name), class: "small" %><br />
  </div>
<% end %>

<%- if devise_mapping.lockable? && resource_class.unlock_strategy_enabled?(:email) && controller_name != 'unlocks' %>
  <div class="text-center">
    <%= link_to t('common.didnt_receive_unlock'), new_unlock_path(resource_name), class: "small" %><br />
  </div>
<% end %>

<%- if devise_mapping.omniauthable? %>
  <%- resource_class.omniauth_providers.each do |provider| %>
    <%= button_to t('common.login_with_google'), omniauth_authorize_path(resource_name, provider), data: { turbo: false } %><br />
  <% end %>
<% end %>
