<div class="container" data-controller="keys">
  <div class="card">
    <div class="card-header bg-main d-flex justify-content-between align-items-center">
      <h3 class="text-center mx-auto"><%= t('keys.title') %> (<span id="keys-count"></span>)</h3>
      <%= link_to t('keys.add_key'), new_key_path, class: "btn btn-success" %>
    </div>


    <div class="card-body">

      <div class="container">
        <div class="row font-weight-bold border-bottom">
          <div class="col-md-4 text-center"><%= t('keys.columns.key_number') %></div>
          <div class="col-md-4 text-center"><%= t('keys.columns.upp_key') %></div>
          <div class="col-md-4 text-center"><%= t('keys.columns.actions') %></div>
        </div>

        <%= search_form_for @q, class: "row g-3 mt-2 mb-4", data: { turbo_frame: :results } do |f| %>
          <div class="col-md-4">
            <%= f.search_field :num_key_cont, class: "form-control me-2", placeholder: t('keys.search.key'), oninput: 'this.form.requestSubmit()', autofocus: true, autocomplete: 'off' %>
          </div>
          <div class="col-md-4">
            <%= f.search_field :upp_cont, class: "form-control", placeholder: t('keys.search.upp'), oninput: 'this.form.requestSubmit()', autocomplete: 'off' %>
          </div>
          <div class="col-md-4">
          </div>
        <% end %>

        <%= turbo_frame_tag :results, data: { turbo_action: 'advance' } do %>
          <div id="keys" >
          </div>
          <%= turbo_frame_tag :pagination, loading: :lazy, src: keys_path(format: :turbo_stream, q: params[:q]&.to_unsafe_h) %>
        <% end %>
      </div>
    </div>
  </div>
</div>
