<div class="card-body">
  <%= form_with(model: @producer) do |form| %>
    <% if @producer.errors.any? %>
      <div class="alert alert-danger" role="alert">
        <h4 class="alert-heading">
          <%= t('producers.errors.prohibited', count: @producer.errors.count) %>
        </h4>
        <ul>
          <% @producer.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= form.label :upp_key,  class: "form-label" %>
      <%= form.text_field :upp_key,  class: "form-control" %>
    </div>

    <div>
      <%= form.label :producer_full_name,  class: "form-label" %>
      <%= form.text_field :producer_full_name,  class: "form-control" %>
    </div>

    <div>
      <%= form.label :produced_adress,  class: "form-label" %>
      <%= form.text_field :produced_adress,  class: "form-control" %>
    </div>

   <div class="mt-2 text-end">
     <%= link_to "Cancelar", producers_path, class: "btn btn-danger" %>
     <%= form.submit "Guardar", class: "btn btn-success" %>
   </div>
  <% end %>
</div>
