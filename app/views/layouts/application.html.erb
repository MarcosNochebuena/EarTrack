<!DOCTYPE html>
<html>
  <head>
    <title>EarTrack</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag 'application', media: 'all', 'data-turbolinks-track': 'reload' %>
    <%= javascript_include_tag 'application', 'data-turbolinks-track': 'reload' %>>
    <%= stylesheet_link_tag "https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css", media: "all" %>
    <%= stylesheet_link_tag "https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.0/css/all.min.css", media: "all" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="<%= user_signed_in? ? 'sb-nav-fixed' : 'bg-body'%>"> 
    <%= render 'shared/notices' %>
    <% if user_signed_in? %>
      <%= render 'shared/navbar' %>
      <div id="layoutSidenav">
        <%= render 'shared/sidebar' %>
        <div id="layoutSidenav_content">
          <%= yield %>
          <%= render 'shared/footer' %>
        </div>
      </div>
    <% else %>
      <%= yield %>
    <% end %>
  </body>
</html>