<div id="flash-messages">
  <%= render 'shared/flash_content' %>
</div>

<script>
document.addEventListener("turbo:load", function() {
  showFlashMessage();
});

document.addEventListener("turbo:before-stream-render", function(event) {
  if (event.detail.newStream && event.detail.newStream.target === "flash-messages") {
    setTimeout(showFlashMessage, 100);
  }
});

document.addEventListener("turbo:frame-render", function(event) {
  showFlashMessage();
});

function showFlashMessage() {
  const flashMessages = document.getElementById("flash-messages");
  console.log("Flash messages element:", flashMessages);

  if (flashMessages) {
    // Buscar el span dentro del flash-messages
    const messageSpan = flashMessages.querySelector("span");

    if (messageSpan) {
      const message = messageSpan.getAttribute("data-message");
      const type = messageSpan.getAttribute("data-type");

      if (message && type) {
        showAlert(message, type);
      }
    }
  }
}

function showAlert(message, type) {
  const commonConfig = {
    position: "top-end",
    title: message,
    showConfirmButton: false,
    timer: type === 'error' ? 3000 : 1500,
    timerProgressBar: true,
    didOpen: (toast) => {
      toast.addEventListener('mouseenter', Swal.stopTimer)
      toast.addEventListener('mouseleave', Swal.resumeTimer)
    }
  };

  if (type === 'success') {
    Swal.fire({
      ...commonConfig,
      icon: "success",
      toast: true
    });
  } else if (type === 'error') {
    Swal.fire({
      ...commonConfig,
      icon: "error",
      toast: true
    });
  }
}
</script>
